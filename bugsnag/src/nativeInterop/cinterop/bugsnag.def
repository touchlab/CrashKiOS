package = co.touchlab.crashkios.bugsnag.objc
language = Objective-C
headers = CrashKiOSBugsnagSink.h

# Protocol-only cinterop: the header (owned by the Swift package, see
# Sources/CrashKiOSBugsnagObjC/include/) declares no external classes or
# functions, so this emits NO undefined symbols — no -U flags, no cacheKind=none,
# no App Store strip hazard. The Swift app implements the protocol and registers
# it via registerBugsnagSink().
